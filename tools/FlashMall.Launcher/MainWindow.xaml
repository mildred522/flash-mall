<Window x:Class="FlashMall.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FlashMall.Launcher.Models"
        Title="Flash Mall 控制中心"
        Width="1120"
        Height="740"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0C1117"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#32D296" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111820" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8B98A5" />
        <SolidColorBrush x:Key="BorderBrush" Color="#26313C" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DCE5EC" />
            <Setter Property="Background" Value="#18222D" />
            <Setter Property="BorderBrush" Value="#2B3946" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#21303C" />
                    <Setter Property="BorderBrush" Value="#435565" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#07130F" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#57E0AE" />
                    <Setter Property="BorderBrush" Value="#57E0AE" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1016" />
            <Setter Property="Foreground" Value="#DCE5EC" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#18222D" />
            <Setter Property="Foreground" Value="#DCE5EC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style x:Key="StatusSurface" TargetType="Border">
            <Setter Property="Background" Value="#151D26" />
            <Setter Property="BorderBrush" Value="#34414E" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProjectState.Ready}">
                    <Setter Property="Background" Value="#10251E" />
                    <Setter Property="BorderBrush" Value="#28785B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProjectState.Partial}">
                    <Setter Property="Background" Value="#2A2110" />
                    <Setter Property="BorderBrush" Value="#8A681E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProjectState.Failed}">
                    <Setter Property="Background" Value="#2B171B" />
                    <Setter Property="BorderBrush" Value="#8D3945" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,26,28,28">
                <TextBlock Text="F L A S H  M A L L" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="开发控制中心" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock Text="Hertz 网关 · Kitex 库存链路 · WSL Docker" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />

                <Border Style="{StaticResource StatusSurface}" CornerRadius="8" Padding="17" Margin="0,24,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,7,0,0" />
                        <StackPanel Grid.Column="1" Margin="8,0,12,0">
                            <TextBlock Text="{Binding StateText}" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PhaseText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" Padding="10,5" VerticalAlignment="Top" />
                    </Grid>
                </Border>
                <ProgressBar Height="2" Margin="1,-2,1,0" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Text="项目操作" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,23,0,8" />
                <Button Content="启动项目" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Height="44" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="重新构建并启动" Command="{Binding RebuildCommand}" Height="40" />
                    <Button Grid.Column="2" Content="停止项目" Command="{Binding StopCommand}" Height="40" />
                </Grid>

                <TextBlock Text="本地入口" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,23,0,8" />
                <UniformGrid Columns="3">
                    <Button Content="商城" Command="{Binding OpenUrlCommand}" CommandParameter="http://127.0.0.1:8889/shop" Margin="0,0,5,0" Padding="5,8" />
                    <Button Content="平台后台" Command="{Binding OpenUrlCommand}" CommandParameter="http://127.0.0.1:8889/admin" Margin="0,0,5,0" Padding="5,8" />
                    <Button Content="商家后台" Command="{Binding OpenUrlCommand}" CommandParameter="http://127.0.0.1:8889/merchant" Padding="5,8" />
                    <Button Content="MQ" Command="{Binding OpenUrlCommand}" CommandParameter="http://127.0.0.1:15672" Margin="0,6,5,0" Padding="5,8" />
                    <Button Content="链路" Command="{Binding OpenUrlCommand}" CommandParameter="http://127.0.0.1:16686" Margin="0,6,5,0" Padding="5,8" />
                </UniformGrid>

                <Expander Margin="0,24,0,0" Foreground="#DCE5EC">
                    <Expander.Header>
                        <TextBlock Text="高级操作与设置" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="业务服务" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" Margin="0,6,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="重建选中服务" Command="{Binding RebuildServiceCommand}" />
                            <Button Grid.Column="2" Content="读取服务日志" Command="{Binding LoadLogsCommand}" />
                        </Grid>

                        <TextBlock Text="服务状态" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,17,0,6" />
                        <ItemsControl ItemsSource="{Binding ServiceStatuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="WSL 发行版" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,17,0,6" />
                        <TextBox Text="{Binding Distro, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="WSL 项目路径" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,11,0,6" />
                        <TextBox Text="{Binding Workspace, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="健康等待秒数（30–900）" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,11,0,6" />
                        <TextBox Text="{Binding WaitTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="保存启动设置" Command="{Binding SaveSettingsCommand}" Margin="0,10,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="#25303A" />

        <Grid Grid.Column="2" Margin="28,26,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="运行日志" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="控制事件与 Docker 原始输出会同步保存在本机。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="打开日志目录" Command="{Binding OpenLogDirectoryCommand}" VerticalAlignment="Center" />
            </Grid>
            <TextBox x:Name="LogTextBox"
                     Grid.Row="2"
                     Text="{Binding LogText, Mode=OneWay}"
                     TextChanged="LogTextBox_OnTextChanged"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="12.5"
                     TextBlock.LineHeight="19"
                     TextWrapping="NoWrap"
                     Padding="14"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Window>
