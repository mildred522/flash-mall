# Keep repository text stable across Windows PowerShell and WSL checkouts.
# Binary assets remain auto-detected and are not line-ending normalized.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Vite single-file output contains third-party template literals where trailing
# spaces can be semantically significant. Keep line endings stable, but do not
# apply source-style whitespace checks to generated bundles.
artifacts/web/admin.html text eol=lf -whitespace
artifacts/web/merchant.html text eol=lf -whitespace
artifacts/web/shop.html text eol=lf -whitespace
