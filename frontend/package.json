{
  "name": "flash-mall-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/shop",
    "packages/admin",
    "packages/merchant"
  ],
  "scripts": {
    "dev:shop": "npm run dev -w packages/shop",
    "dev:admin": "npm run dev -w packages/admin",
    "dev:merchant": "npm run dev -w packages/merchant",
    "build:shop": "npm run build -w packages/shop",
    "build:admin": "npm run build -w packages/admin",
    "build:merchant": "npm run build -w packages/merchant",
    "build": "node build.js",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
