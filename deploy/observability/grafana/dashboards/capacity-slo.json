{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Hertz API 吞吐",
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [
        {
          "expr": "sum by (route, status_class) (rate(flashmall_http_requests_total{route=~\"/api/.*\"}[1m]))",
          "legendFormat": "{{route}} / {{status_class}}"
        }
      ],
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "API 成功率",
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [
        {
          "expr": "100 * sum(rate(flashmall_http_requests_total{route=~\"/api/.*\",status_class=\"2xx\"}[5m])) / clamp_min(sum(rate(flashmall_http_requests_total{route=~\"/api/.*\"}[5m])), 0.001)",
          "legendFormat": "success"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 99},
              {"color": "green", "value": 99.9}
            ]
          }
        }
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Hertz API p95",
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(flashmall_http_request_duration_seconds_bucket{route=~\"/api/.*\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Hertz API p99",
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(flashmall_http_request_duration_seconds_bucket{route=~\"/api/.*\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Hertz 在途请求",
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [
        {
          "expr": "flashmall_http_in_flight_requests",
          "legendFormat": "in flight"
        }
      ],
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 16}
    },
    {
      "type": "timeseries",
      "title": "服务端错误率",
      "id": 6,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [
        {
          "expr": "100 * sum(rate(flashmall_http_requests_total{route=~\"/api/.*\",status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(flashmall_http_requests_total{route=~\"/api/.*\"}[5m])), 0.001)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0}},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 16}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["flash-mall", "capacity", "slo"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "title": "Flash Mall / 容量与 SLO",
  "uid": "flashmall-capacity-slo",
  "version": 1
}
