{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "timeseries", "title": "Hertz 主页读取速率", "id": 1,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [{"expr": "sum by (audience, result) (rate(flashmall_showcase_read_total[5m]))", "legendFormat": "{{audience}} / {{result}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries", "title": "Hertz 展示读取 p95", "id": 2,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, audience) (rate(flashmall_showcase_request_duration_seconds_bucket[5m])))", "legendFormat": "{{audience}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries", "title": "库存命令吞吐与结果", "id": 3,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [{"expr": "sum by (operation, result) (rate(inventory_kitex_commands_total[5m]))", "legendFormat": "{{operation}} / {{result}}"}],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
    },
    {
      "type": "timeseries", "title": "商品存在性过滤结果", "id": 4,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [{"expr": "sum by (result) (rate(flashmall_existence_filter_checks_total{entity=\"product\"}[5m]))", "legendFormat": "{{result}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "type": "timeseries", "title": "商品负缓存命中结果", "id": 5,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [{"expr": "sum by (result) (rate(flashmall_negative_cache_requests_total{entity=\"product\"}[5m]))", "legendFormat": "{{result}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    },
    {
      "type": "stat", "title": "商品过滤器就绪", "id": 6,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [{"expr": "max(flashmall_existence_filter_ready{entity=\"product\"})", "legendFormat": "ready"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "未就绪", "color": "red"}, "1": {"text": "就绪", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 24}
    },
    {
      "type": "stat", "title": "过滤器商品数量", "id": 7,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [{"expr": "max(flashmall_existence_filter_items{entity=\"product\"})", "legendFormat": "items"}],
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 24}
    },
    {
      "type": "timeseries", "title": "过滤器更新与假阳性", "id": 8,
      "datasource": {"type": "prometheus", "uid": "flashmall-prometheus"},
      "targets": [
        {"expr": "sum by (result) (rate(flashmall_existence_filter_updates_total{entity=\"product\"}[5m]))", "legendFormat": "update / {{result}}"},
        {"expr": "sum(rate(flashmall_existence_filter_false_positive_total{entity=\"product\"}[5m]))", "legendFormat": "false positive"}
      ],
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 24}
    }
  ],
  "refresh": "10s", "schemaVersion": 39, "tags": ["flash-mall", "overview"],
  "templating": {"list": []}, "time": {"from": "now-1h", "to": "now"},
  "title": "Flash Mall / 总览", "uid": "flashmall-overview", "version": 1
}
